# The number that receives order invoices, in international format.
# Digits only is fine — anything else is stripped. Leave it unset and orders
# go to a placeholder line (ORDER_WHATSAPP_FALLBACK in src/config/contact.ts),
# so test orders from visitors never reach a real phone.
#
# NOTE: this reaches the browser. It is kept out of the repository, not out of
# devtools — a front-end with no backend cannot hide it.
NEXT_PUBLIC_WHATSAPP_NUMBER=201111111111

# ── Data source ────────────────────────────────────────────────────────────
# Leave as "true" to use the in-repo catalogue (no setup needed).
# Set to "false" to read products and reviews from Sanity.
NEXT_PUBLIC_USE_MOCK_API=true

# Your Sanity project (see dashboard/README.md).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token with Editor rights, used to save contact-form inquiries.
# Never prefix it with NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
